# Backend environment variables for Kubi
# -------------------------------------------------
# Core settings

# JWT settings
JWT_SECRET_KEY=replace-with-strong-secret

# Resend (email/OTP) settings
RESEND_API_KEY=your-resend-api-key

# SSO / OAuth client IDs (placeholders – fill with real values)

# Optional: Elastic search / other services (keep empty if unused)

# Additional optional settings

# Missing secret keys for local dev / Minikube secret generator
DB_PASSWORD=dummy
GEMINI_API_KEY=dummy
GITLAB_TOKEN=dummy
ARIZE_SPACE_ID=dummy
ARIZE_API_KEY=dummy
SSO_CLIENT_ID=dummy
SSO_CLIENT_SECRET=dummy

