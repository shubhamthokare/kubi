# ==============================================================================
# Kubi Master Environment Configurations & Secrets (Centralized)
# ==============================================================================
# Copy to .env in the root directory and fill in your values.
# The deployment scripts will automatically propagate these values to all services.
# ==============================================================================

# ── General ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME=kubi-AI
LOG_LEVEL=INFO

# ── AI & API Keys ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=dummy

# ── Database (MongoDB) ────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=kubi
DB_PASSWORD=dummy

# ── GitLab Integration ────────────────────────────────────────────────────────
GITLAB_API_URL=https://gitlab.com/api/v4
# Both aliases supported
GITLAB_PRIVATE_TOKEN=your-gitlab-token-here
GITLAB_TOKEN=your-gitlab-token-here

# ── Observability & Tracing (Arize / OpenTelemetry) ───────────────────────────
ARIZE_SPACE_ID=your-space-id-here
ARIZE_API_KEY=dummy-here
ARIZE_PROJECT_NAME=kubi-backend
PHOENIX_COLLECTOR_ENDPOINT=

# ── Elasticsearch (Semantic Search & RAG) ─────────────────────────────────────
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=kubi-incidents
ELASTICSEARCH_INDEX_LOGS=kubi-pod-logs
ELASTICSEARCH_INDEX_EVENTS=kubi-events
ELASTICSEARCH_INDEX_RCA=kubi-rca
ELASTICSEARCH_INDEX_REMEDIATION=kubi-remediation
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=0

# ── Email & Authentication ────────────────────────────────────────────────────
RESEND_API_KEY=dummy
EMAIL_FROM=no-reply@kubi.ai
OTP_EXPIRY_MINUTES=10
JWT_SECRET_KEY=kubi-sre-secret-key-change-me-in-production

# ── Agent Specifics ───────────────────────────────────────────────────────────
CLUSTER_ID=kubi-production-cluster
TARGET_NAMESPACE=*
SCAN_INTERVAL=30
KUBECONFIG=~/.kube/config
AGENT_URL=http://localhost:8080
KUBI_BACKEND_URL=http://localhost:8000

# ── Frontend Specifics ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_URL=http://localhost:8080

# ── SSO Integration ───────────────────────────────────────────────────────────
SSO_CLIENT_ID=dummy
SSO_CLIENT_SECRET=dummy
