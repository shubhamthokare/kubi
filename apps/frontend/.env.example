# =============================================================
# Kubi Frontend — .env.example (commit this, NOT the .env.local)
# =============================================================
# Copy to .env.local and fill in real values before running.
# Used by Next.js at build time and runtime (NEXT_PUBLIC_ prefix
# means values are embedded in the browser bundle).
#
# LOCAL DEV (npm run dev):
#   - Port-forward backend: kubectl port-forward svc/kubi-backend-service 8000:8000 -n kubi
#   - Then NEXT_PUBLIC_API_URL=http://localhost:8000/api
#
# IN-CLUSTER / MINIKUBE TUNNEL:
#   - minikube tunnel  →  frontend is at http://127.0.0.1:49262
#   - Backend reached via NodePort or port-forward
# =============================================================

# ── Backend API base URL ──────────────────────────────────────
# Local dev (port-forwarded backend):
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Minikube NodePort direct (use when NOT port-forwarding):
# NEXT_PUBLIC_API_URL=http://192.168.49.2:30000/api

# ── Frontend public URL (used for CORS & redirects) ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Agent URL (shown in dashboard defaults) ───────────────────
# Internal cluster DNS — works from inside the cluster only.
# For local dev testing override this with a port-forward URL.
NEXT_PUBLIC_AGENT_URL=http://kubi-agent-service:8080

# ── Minikube tunnel URL (informational) ───────────────────────
# Run: minikube tunnel   → frontend available at:
NEXT_PUBLIC_MINIKUBE_TUNNEL_URL=http://127.0.0.1:49262
