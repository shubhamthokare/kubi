# =============================================================
# Kubi Agent — Local Environment
# =============================================================
# Copy this to .env in the agent directory and fill in values.
# In-cluster: values are sourced from the kubi-agent-config
# ConfigMap defined in deploy/k8s/agent/agent-configmap.yaml.
#
# LOCAL DEV (running agent outside the cluster):
#   1. Port-forward backend: kubectl port-forward svc/kubi-backend-service 8000:8000 -n kubi
#   2. Ensure KUBECONFIG points to your local ~/.kube/config
#   3. Set KUBI_BACKEND_URL=http://localhost:8000
# =============================================================

# ── Cluster Identity ──────────────────────────────────────────
CLUSTER_ID=kubi-internal-agent

# ── Target Namespace ──────────────────────────────────────────
# Use '*' to scan all namespaces
TARGET_NAMESPACE=*

# ── Scan Interval (seconds) ───────────────────────────────────
SCAN_INTERVAL=30

# ── Backend URL ───────────────────────────────────────────────
# Local dev (port-forwarded backend):
KUBI_BACKEND_URL=http://localhost:8000

# In-cluster DNS (used when deployed inside Kubernetes):
# KUBI_BACKEND_URL=http://kubi-backend-service:8000

# ── Arize Tracing (optional) ─────────────────────────────────
ARIZE_SPACE_ID=your-space-id-here
ARIZE_API_KEY=your-api-key-here
ARIZE_PROJECT_NAME=kubi-agent
