# =============================================================
# Kubi Backend — .env.example (commit this, NOT the .env)
# =============================================================
# Copy to .env and fill in real values before running.
# =============================================================

ENVIRONMENT=development
PROJECT_NAME=kubi-AI

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=kubi

# Gemini AI (required)
GEMINI_API_KEY=your-gemini-api-key-here

# GitLab Integration
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PRIVATE_TOKEN=your-gitlab-token-here

# Agent URL — local port-forward: kubectl port-forward svc/kubi-agent-service 8080:8080 -n kubi
AGENT_URL=http://localhost:8080

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:49262,http://192.168.49.2:30001

# Elasticsearch (optional)
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=kubi-incidents
ELASTICSEARCH_INDEX_LOGS=kubi-pod-logs
ELASTICSEARCH_INDEX_EVENTS=kubi-events
ELASTICSEARCH_INDEX_RCA=kubi-rca
ELASTICSEARCH_INDEX_REMEDIATION=kubi-remediation
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=0

# Arize Tracing (optional)
ARIZE_SPACE_ID=your-space-id-here
ARIZE_API_KEY=your-api-key-here
ARIZE_PROJECT_NAME=kubi-backend
