#!/bin/bash

# Read the target branch being pushed
while read local_ref local_sha remote_ref remote_sha
do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo "=================================================="
        echo "🔍 [Git Hook] Pre-push verification active for 'main'"
        echo "=================================================="
        echo "Running backend test suite..."
        
        # Navigate to the backend application folder
        cd apps/backend
        
        # Run pytest with PYTHONPATH set locally
        PYTHONPATH=. pytest tests/ -v
        
        # Capture the test runner's exit status
        TEST_STATUS=$?
        
        echo "=================================================="
        
        if [ $TEST_STATUS -ne 0 ]; then
            echo -e "\033[0;31m❌ [Git Hook] Tests failed! Aborting push to 'main'.\033[0m"
            echo "Please fix the failing tests before pushing."
            echo "=================================================="
            exit 1
        else
            echo -e "\033[0;32m✅ [Git Hook] All tests passed. Proceeding with push.\033[0m"
            echo "=================================================="
            exit 0
        fi
    fi
done

exit 0
