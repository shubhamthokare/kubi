#!/bin/bash

echo "=================================================="
echo "🔍 [Git Hook] Pre-push verification active for all branches"
echo "=================================================="

# --- GitGuardian secrets check ---
if command -v ggshield >/dev/null 2>&1; then
  echo "🛡️  Running GitGuardian secrets scan..."
  ggshield secret scan path .
  RESULT=$?
  if [ $RESULT -ne 0 ]; then
    echo -e "\n\033[0;31m✖️  GitGuardian detected potential secrets. Push aborted.\033[0m"
    exit 1
  fi
  echo "✅ No secrets detected."
elif [ -f "C:/Users/shubh/AppData/Roaming/Python/Python314/Scripts/ggshield.exe" ]; then
  echo "🛡️  Running GitGuardian secrets scan..."
  "C:/Users/shubh/AppData/Roaming/Python/Python314/Scripts/ggshield.exe" secret scan path .
  RESULT=$?
  if [ $RESULT -ne 0 ]; then
    echo -e "\n\033[0;31m✖️  GitGuardian detected potential secrets. Push aborted.\033[0m"
    exit 1
  fi
  echo "✅ No secrets detected."
else
  echo "⚠️  WARNING: ggshield not found. Skipping secrets scan."
fi

# --- Branch restriction check ---
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "main" ]; then
  echo -e "\n\033[0;31m⚠️  Pre-push hook only allows pushes to the 'main' branch. Current branch: $CURRENT_BRANCH\033[0m"
  exit 1
fi
echo "✅ Push is targetting allowed branch: $CURRENT_BRANCH"
echo "=================================================="

# Check if pytest and python are available locally
if command -v pytest >/dev/null 2>&1; then
    echo "🚀 Running Backend tests locally using system pytest..."
    cd apps/backend
    PYTHONPATH=. pytest tests/ -v
    BACKEND_STATUS=$?
    cd ../..
    
    echo "🚀 Running Agent tests locally using system python..."
    cd apps/agent
    PYTHONPATH=. python -m unittest discover -s tests -v
    AGENT_STATUS=$?
    cd ../..
    
    if [ $BACKEND_STATUS -eq 0 ] && [ $AGENT_STATUS -eq 0 ]; then
        TEST_STATUS=0
    else
        TEST_STATUS=1
    fi
# Check if docker is available to run tests in containers
elif command -v docker >/dev/null 2>&1; then
    echo "🐳 Local pytest not found. Running tests inside cached Docker containers..."
    
    echo "Running Backend tests..."
    docker build -q -t kubi-backend-test ./apps/backend >/dev/null
    docker run --rm kubi-backend-test pytest tests/ -v
    BACKEND_STATUS=$?
    
    echo "Running Agent tests..."
    docker build -q -t kubi-agent-test ./apps/agent >/dev/null
    docker run --rm kubi-agent-test python -m unittest discover -s tests -v
    AGENT_STATUS=$?
    
    if [ $BACKEND_STATUS -eq 0 ] && [ $AGENT_STATUS -eq 0 ]; then
        TEST_STATUS=0
    else
        TEST_STATUS=1
    fi
else
    echo "⚠️ WARNING: Neither pytest nor Docker was found. Cannot verify tests!"
    echo "Please install pytest locally or start Docker to verify builds."
    TEST_STATUS=1
fi

echo "=================================================="

if [ $TEST_STATUS -ne 0 ]; then
    echo -e "\033[0;31m❌ [Git Hook] Tests failed! Aborting push.\033[0m"
    echo "Please fix the failing tests before pushing."
    echo "=================================================="
    exit 1
else
    echo -e "\033[0;32m✅ [Git Hook] All tests passed. Proceeding with push.\033[0m"
    echo "=================================================="
    exit 0
fi
